# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
# uv creates .venv/; venv/, env/ and ENV/ are kept for legacy / hand-made setups.
.venv/
venv/
ENV/
env/

# uv
# uv.lock IS committed on purpose (it is the reproducible lock); only local-only files are ignored.
.uv/
# Local uv settings, e.g. a personal package index mirror. Prefer the UV_* environment variables
# (uv does NOT read .env files — export them in your shell, CI or Dockerfile) or, for a setting the
# whole team should share, pyproject.toml -> [tool.uv]; force-add this file if it needs committing.
uv.toml

# Local lint configuration. Committed code must never depend on it: CI passes the exclusions that
# keep .venv/ (uv creates the environment inside the repository) out of the lint run on the
# command line. Recreate the file locally if you want the same behaviour when running flake8.
.flake8

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Storage - keep directory structure but ignore data files
storage/vectordb/*
!storage/vectordb/.gitkeep
storage/documents/*
!storage/documents/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/tasks/*
!storage/tasks/.gitkeep
storage/abtest_results/*
!storage/abtest_results/.gitkeep
storage/monitor/*
!storage/monitor/.gitkeep
storage/traces/*
!storage/traces/.gitkeep
storage/optimized_docs/*
!storage/optimized_docs/.gitkeep
storage/evaluation/*
!storage/evaluation/.gitkeep
# Legacy ChromaDB persist directory (the current default is ./storage/vectordb, see settings.yaml).
# Kept explicit so stale data from older builds can never be committed either.
storage/chroma_db/*
!storage/chroma_db/.gitkeep
storage/*.json
!storage/.gitkeep
# NOTE: for every new runtime directory add a "storage/<dir>/*" + "!storage/<dir>/.gitkeep"
# pair. A blanket "storage/**" would also exclude the directories themselves, and git cannot
# re-include a file whose parent directory is excluded.

