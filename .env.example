# =============================================================================
# whiteBoxRAG Environment Variables
# =============================================================================
# Usage: copy this file to .env and fill in actual values
#   cp .env.example .env
#
# The .env file is loaded automatically by config/__init__.py via python-dotenv
# at application startup. Environment variables take the HIGHEST priority,
# overriding values in config/settings.yaml.
#
# .env must NOT be committed to version control (already ignored in .gitignore).
# Only .env.example is tracked.
# =============================================================================

# ---- LLM Provider Selection ----
# Which LLM backend to use: ollama | openai
LLM_PROVIDER=ollama

# ---- Ollama Configuration (local deployment) ----
# Base URL of the Ollama server
OLLAMA_BASE_URL=http://localhost:11434
# LLM model name (pull via: ollama pull <model>)
OLLAMA_LLM_MODEL=qwen2.5:7b
# Embedding model name
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Embedding vector dimension (must match the embedding model)
OLLAMA_EMBEDDING_DIM=768
# Request timeout in seconds
OLLAMA_TIMEOUT=60
# Max retry attempts on LLM failure
OLLAMA_MAX_RETRIES=3

# ---- OpenAI Configuration (cloud alternative) ----
# API key — obtain from https://platform.openai.com/api-keys
# REQUIRED when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Base URL (use a custom proxy if needed, otherwise leave default)
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM model name
OPENAI_LLM_MODEL=gpt-4o
# Embedding model name
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension
OPENAI_EMBEDDING_DIM=1536
# Request timeout in seconds
OPENAI_TIMEOUT=60

# ---- Application Security ----
# RESERVED: this value is read into config (api.api_key) but NOT verified by the REST API yet,
# so setting it has no effect. whiteBoxRAG ships without built-in authentication: keep the
# service on a trusted network, bind it to 127.0.0.1 (python main.py --host 127.0.0.1) or put
# it behind an authenticating reverse proxy. See the "Security" section of README.md.
API_KEY=
# Rate limit: max requests per minute per client IP
API_RATE_LIMIT=60
