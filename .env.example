# =============================================================================
# whiteBoxRAG Environment Variables
# =============================================================================
# Usage: copy this file to .env and fill in actual values
#   cp .env.example .env
#
# IMPORTANT — this .env file is the SOLE SOURCE of truth for LLM provider
# configuration (ollama / openai). config/settings.yaml no longer carries any
# LLM-related keys — application modules read them through config.get() and
# receive values injected here by python-dotenv.
#
# .env must NOT be committed to version control (already ignored in .gitignore).
# Only .env.example is tracked as a reference template.
# =============================================================================

### ---- LLM Provider Selection ----  ###
### Which LLM backend to use: ollama | openai for offline and online
# By default , it use ollama light model for offline deployment beccause the primary of whiteBox
# is designed for RAG tracability and explainability.
LLM_PROVIDER=ollama

# ---- Ollama Configuration (local deployment) ----
# Base URL of the Ollama server
OLLAMA_BASE_URL=http://localhost:11434
# LLM model name (pull via: ollama pull <model> you want to use for RAG)
OLLAMA_LLM_MODEL=qwen2.5:7b
# Request timeout in seconds
OLLAMA_TIMEOUT=60
# Max retry attempts on LLM failure
OLLAMA_MAX_RETRIES=3

# ---- OpenAI Configuration (cloud alternative) ----
# API key — obtain from https://platform.openai.com/api-keys
# REQUIRED when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Base URL (use a custom proxy if needed, otherwise leave default)
OPENAI_BASE_URL=https://api.openai.com/v1
# LLM model name
OPENAI_LLM_MODEL=gpt-4o
# Request timeout in seconds
OPENAI_TIMEOUT=60

# ---- Embedding Provider Selection ----
# Embedding is INDEPENDENT from LLM — you can mix backends freely.
# Options: ollama | openai | local
#   ollama — uses OLLAMA_EMBEDDING_MODEL (below) via the Ollama API
#   openai — uses OPENAI_EMBEDDING_MODEL (below) via an OpenAI-compatible API
#   local  — loads a local HuggingFace model in-process (fastest, no network call);
#            requires the optional dependency: uv sync --extra local-embedding
# If left blank, falls back to whatever LLM_PROVIDER is.
#
# Default matches the Ollama-first quick start in README.md (ollama pull nomic-embed-text).
EMBEDDING_PROVIDER=ollama

# ---- Embedding via Ollama ----
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_EMBEDDING_DIM=768

# ---- Embedding via OpenAI (uncomment when EMBEDDING_PROVIDER=openai) ----
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#OPENAI_EMBEDDING_DIM=1536

# ---- Local Embedding Model (only when EMBEDDING_PROVIDER=local) ----
# Both lines are REQUIRED in that mode — the startup check in main.py aborts without them.
# Path to a HuggingFace-format embedding model, OR a model name that can be downloaded.
# Example (path): LOCAL_EMBEDDING_MODEL_PATH=D:\models\bge-large-zh-v1.5
# Example (name): LOCAL_EMBEDDING_MODEL_PATH=BAAI/bge-large-zh-v1.5
# LOCAL_EMBEDDING_DIM must match the model: bge-large-zh outputs 1024 dims, bge-base-zh 768.
# Check your model's docs if unsure — a mismatch makes every search fail.
#LOCAL_EMBEDDING_MODEL_PATH=BAAI/bge-large-zh-v1.5
#LOCAL_EMBEDDING_DIM=1024


# ---- Application Security ----
# RESERVED: this value is read into config (api.api_key) but NOT verified by the REST API yet,
# so setting it has no effect. whiteBoxRAG ships without built-in authentication: keep the
# service on a trusted network, bind it to 127.0.0.1 (python main.py --host 127.0.0.1) or put
# it behind an authenticating reverse proxy. See the "Security" section of README.md.
API_KEY=
# Rate limit: max requests per minute per client IP
API_RATE_LIMIT=60


# whiteBox RAG configuration
# host and port
HOST=localhost
PORT=8080
# Author of the RAG system. NOTE: the name is read as AUTHOR, in upper case — environment
# variables are case-sensitive on Linux/macOS, so "Author=" would be silently ignored there.
AUTHOR=JunSuAI

# Backend-side default language for logs and exception messages (zh-CN | en-US).
# API response language is driven by the client's Accept-Language header / ?lang= query param.
DEFAULT_LANG=en-US
